CONFIG_HAPPY_HARE_VERSION="4.0.0"
CONFIG_MMU_UNITS="unit0"
CONFIG_UNIT_NAME="unit0"
CONFIG_MCU_NAME="unit0"
CONFIG_UNIT_INDEX=0
CONFIG_INSTALL_CLIENT_MACROS=y
CONFIG_KLIPPER_HOME="~/klipper"
CONFIG_MOONRAKER_HOME="~/moonraker"
CONFIG_KLIPPER_CONFIG_HOME="~/printer_data/config"
CONFIG_PRINTER_CONFIG_FILE="printer.cfg"
CONFIG_MOONRAKER_CONFIG_FILE="moonraker.conf"
CONFIG_SERVICE_KLIPPER="klipper.service"
CONFIG_SERVICE_MOONRAKER="moonraker.service"
CONFIG_INIT_SYSTEMD=y
CONFIG_VIRTUAL_SELECTOR=y
CONFIG_MULTIGEAR=y
CONFIG_PARAM_GEAR_GEAR_RATIO="50:17"
CONFIG_PARAM_GATE_PARKING_DISTANCE=-1000
CONFIG_PARAM_GATE_HOMING_MAX=1500
CONFIG_MMU_TYPE_3MS_1_0=y
CONFIG_PIN_GEAR_DIR="!unit0:gpio10"
CONFIG_PIN_GEAR_DIR_1="!unit0:gpio5"
CONFIG_PIN_GEAR_DIR_2="!unit0:gpio28"
CONFIG_PIN_GEAR_DIR_3="!unit0:gpio13"
CONFIG_BOARD_TYPE_SKR_PICO_1=y
